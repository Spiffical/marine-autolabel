# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=

# Data roots. These replace the hardcoded absolute paths in the old repo.
# Point them at wherever the clips, SeaTube downloads and run outputs live.
MAL_VIDEO_ROOT=/path/to/videos
MAL_SEATUBE_ROOT=/path/to/seatube/downloads
MAL_RUNS_ROOT=/path/to/runs

# GPU host, used by infra/sync_to_remote.sh and infra/remote_python.sh.
# The scripts carry no hostnames or paths of their own.
MAL_REMOTE_HOST=my-gpu-host
MAL_REMOTE_ROOT=/path/to/marine-autolabel
MAL_REMOTE_PYTHON=.venv/bin/python
